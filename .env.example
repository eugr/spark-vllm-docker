# Example .env configuration — Jetson AGX Thor vLLM image
# Copy this file to .env and customize for your environment.

# ---------------------------------------------------------------------
# Cluster configuration (usually unused on single-Thor setups)
# ---------------------------------------------------------------------
# CLUSTER_NODES: Comma-separated list of node IPs (first is head).
# Leave unset for single-Thor deployments (recommended).
# CLUSTER_NODES="192.168.177.11,192.168.177.12"

# ETH_IF: Ethernet interface name.  Auto-detected from the default route.
# On Thor devkits this is typically `eth0` or `enP8p1s0`.
# ETH_IF="eth0"

# IB_IF: InfiniBand / RoCE interface.  Leave empty on stock Thor (no
# ConnectX).  Only set this if you attached a SmartNIC over PCIe; also
# set THOR_ETHERNET_ONLY=0 to re-enable the RoCE auto-detection path.
# IB_IF=""

# LOCAL_IP: Local IP (auto-detected from ETH_IF if unset).
# LOCAL_IP="192.168.1.100"

# MASTER_PORT: Port for cluster coordination (default: 29501)
# MASTER_PORT="29501"

# CONTAINER_NAME: Container name (default: vllm_thor)
CONTAINER_NAME="vllm_thor"

# ---------------------------------------------------------------------
# Container environment variables
# Anything prefixed with CONTAINER_ (except CONTAINER_NAME) becomes a
# `-e` flag passed to `docker run`.  Example:
#   CONTAINER_NCCL_DEBUG=INFO  ->  -e NCCL_DEBUG=INFO
# ---------------------------------------------------------------------
CONTAINER_HF_TOKEN="your_huggingface_token_here"
CONTAINER_NCCL_IGNORE_CPU_AFFINITY="1"
# CONTAINER_NCCL_DEBUG="INFO"

# ---------------------------------------------------------------------
# LMCache (opt-in)
# Set ENABLE_LMCACHE=1 to export the defaults below to the container.
# Combine with `--kv-transfer-config` on the vllm serve command line:
#   --kv-transfer-config '{"kv_connector":"LMCacheConnectorV1","kv_role":"kv_both"}'
# ---------------------------------------------------------------------
# ENABLE_LMCACHE=1
# CONTAINER_LMCACHE_CHUNK_SIZE="256"
# CONTAINER_LMCACHE_LOCAL_CPU="True"
# CONTAINER_LMCACHE_MAX_LOCAL_CPU_SIZE="16"   # GB of CPU DRAM for KV offload

# ---------------------------------------------------------------------
# Build + copy options
# ---------------------------------------------------------------------
# COPY_HOSTS: Comma-separated hosts for build-and-copy.sh -c
# Used when distributing a freshly built image across a multi-Thor lab.
# COPY_HOSTS="192.168.1.101"

# DOCKER_GPU_FLAG: Override Jetson's default --runtime=nvidia.
# Set to "--gpus all" only if you're running on a non-Jetson host.
# DOCKER_GPU_FLAG="--runtime=nvidia"
