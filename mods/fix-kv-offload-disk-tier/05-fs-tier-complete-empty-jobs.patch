@@ -176,6 +176,44 @@ class FileSystemTierManager(SecondaryTierManager):
 
         self._lookup_manager = FsAsyncLookupManager(tier=self, tier_type=self.tier_type)
 
+        # Zero-task jobs. DualQueueThreadPool reports a job finished only from
+        # task_done() of its LAST task, so a job with zero tasks is never
+        # reported and never leaves _inflight_jobs; the tiering manager then
+        # keeps it in _transfer_jobs forever, has_pending_work() stays True and
+        # the engine steps an empty batch every ~1 ms for the rest of its life
+        # (~140% CPU at idle; _transfer_jobs measured 4 -> 127 over 25 h).
+        # Zero-key jobs are real: prepare_write() drops keys already resident
+        # or in flight, so a wave whose keys were all staged by another
+        # request flushes as an empty promotion. They are completed here, on
+        # the next poll, without touching the pool.
+        self._empty_finished: list[JobId] = []
+        self._empty_jobs_seen = 0
+
+    def _enqueue(self, job_metadata: JobMetadata, tasks, kind: str) -> None:
+        # Count the tasks actually built, never len(keys): zip() stops at the
+        # shorter of keys/block_ids, and a count above the real task total is
+        # the same never-finishes leak as a count of zero.
+        tasks = list(tasks)
+        if not tasks:
+            self._empty_jobs_seen += 1
+            n = self._empty_jobs_seen
+            if n <= 20 or n % 100 == 0:
+                logger.warning(
+                    "fs tier: empty %s job %s (keys=%d block_ids=%d) completed "
+                    "immediately; #%d this run",
+                    kind,
+                    job_metadata.job_id,
+                    len(job_metadata.keys),
+                    len(job_metadata.block_ids),
+                    n,
+                )
+            self._empty_finished.append(job_metadata.job_id)
+            return
+        if kind == "store":
+            self._pool.enqueue_store(job_metadata.job_id, len(tasks), tasks)
+        else:
+            self._pool.enqueue_load(job_metadata.job_id, len(tasks), tasks)
+
