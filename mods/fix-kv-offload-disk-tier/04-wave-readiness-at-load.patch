+    def wave_lookup(
+        self, keys: Collection[OffloadKey], req_context: ReqContext
+    ) -> LookupResult:
+        """WAVE STREAMING. Readiness of one wave's keys in the primary tier,
+        evaluated NOW: HIT iff every key is resident and readable, MISS if any
+        key is absent, HIT_PENDING otherwise (a write to one of its rows, a
+        promotion or another request's store, is still in flight).
+
+        The scheduler-side wave driver calls this immediately before
+        `prepare_load()` in the same pass, and `prepare_load()` is what pins
+        the rows (ref_cnt 0 -> 1). Until then a resident row is evictable, so
+        readiness must never be remembered across steps: a row that became
+        resident while the rest of its wave was still promoting (or that was
+        already resident, or was promoted by another request) can be evicted
+        by any intervening `prepare_write`/`prepare_store`; remembering it
+        crashes the engine on `prepare_load`'s `assert block is not None`
+        under concurrent load. MISS -- that eviction, a failed promotion, or a
+        `reset_cache()` wipe -- tells the driver to stage the wave again;
+        `promote_for_staging()` re-reads only the absent keys. Re-staging is
+        not bounded: a key the secondary tier has lost re-reads every step
+        (OPEN A), visible as vllm:kv_offload_wave_retry{reason="miss"}.
+
+        Side-effect-free: `CPUOffloadingManager.lookup` only mutates its
+        `counts` store-threshold tracker when `store_threshold >= 2`, which
+        `CPUPrimaryTierOffloadingManager.__init__` never passes (so `counts`
+        is None), and both cache policies' `get()` are plain dict lookups.
+        """
+        results = {self.primary_tier.lookup(k, req_context) for k in keys}
+        if LookupResult.MISS in results:
+            return LookupResult.MISS
+        if results <= {LookupResult.HIT}:
+            return LookupResult.HIT
+        return LookupResult.HIT_PENDING
 
