+        defeats prefix caching"; the merge path reintroduces it wholesale, with
+        the whole reminder text.
+
+        ``VLLM_ANTHROPIC_MERGE_INLINE_SYSTEM=1`` forces the merge back on for a
+        templateless model that genuinely needs it, without a rebuild.
         """
+        forced = os.environ.get("VLLM_ANTHROPIC_MERGE_INLINE_SYSTEM")
+        if forced is not None:
+            return forced.strip().lower() in ("1", "true", "yes")
