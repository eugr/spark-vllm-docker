+        return super().finish_streaming()
+
+    def _single_pass_parse(self, text, token_ids, initial_state=None):
+        # parse() calls the engine finish directly and bypasses
+        # finish_streaming, and the single-pass delta batch suppresses the
+        # deferred-content gate whenever a real tool call produced deltas,
+        # so sweep unsent phantom slots and flush leftover deferred content
+        # into the returned content here.
+        reasoning, content, tool_call_info = super()._single_pass_parse(
+            text, token_ids, initial_state
