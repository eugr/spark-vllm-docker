+    def _is_phantom_name(self, name: str) -> bool:
+        return bool(name) and _PHANTOM_NAME_RE.fullmatch(name) is None
+
+    def _accept_tool_name(self, name: str) -> bool:
+        if self._is_phantom_name(name):
+            return False
+        return super()._accept_tool_name(name)
+
+    def _rescue_phantom_slot(self, slot) -> None:
+        # A slot holding prose instead of a tool name (the model wrote a
+        # stray opener followed by text that is not a tool call): move the
+        # text into the deferred-content channel so the engine emits it as
+        # regular content instead of dropping it or turning it into a
+        # bogus tool call.
+        name = slot.name.strip()
+        if not name or slot.name_sent or not self._is_phantom_name(name):
+            return
+        text = name
+        args = slot.args.strip()
+        if args:
+            # Render the phantom's argument structure readably: strip the
+            # structural arg markers, keep key/value text ("city Tokyo").
+            args = args.replace(ARG_KEY_START, "").replace(ARG_KEY_END, " ")
+            args = args.replace(ARG_VALUE_START, "").replace(ARG_VALUE_END, " ")
+            text += " " + args.strip()
+        self._deferred_content += text
+        # The engine overwrites deferred content with whitespace-only
+        # content in some delta batches; marking the message as having
+        # non-whitespace content prevents that overwrite from dropping
+        # the rescued text.
+        self._content_has_nonws = True
+        slot.name = ""
+        slot._args_parts.clear()
+        slot._args_joined = ""
+
