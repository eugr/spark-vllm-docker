             def validate_tactic(self, inputs: List[torch.Tensor], tactic) -> bool:
                 return tactic == -1 or _is_cublaslt_algo_tactic(tactic)
 
+            def get_tuning_group_key(self, tactic, inputs):
+                if tactic == -1:
+                    return tactic
+                config = module.cublaslt_algo_config_key(_cublaslt_algo_tensor(tactic))
+                # An unreadable descriptor must still pass the original bytewise check.
+                if not len(config):
+                    return tactic
+                return (
+                    "cublaslt_config",
+                    get_compute_capability(inputs[0].device),
+                    tuple(map(str, self.get_cache_key_extras(inputs))),
+                    *config,
+                )
+
