                 # Enumerate at the bucketed M that keys the tuned tactic, so the
                 # candidates are the same for every M of the bucket.
diff --git a/tests/autotuner/test_autotuner_cublaslt_tactics.py b/tests/autotuner/test_autotuner_cublaslt_tactics.py
index 5793ead614b0186e9c116dce4b2103b93d400ff5..4912a41ef7b0c7db9915a6b736377ab3803aa8a3 100644
--- a/tests/autotuner/test_autotuner_cublaslt_tactics.py
+++ b/tests/autotuner/test_autotuner_cublaslt_tactics.py
@@ -403,6 +403,40 @@ def _runner_and_inputs(backend, m):
     return problem, runner, inputs
 
 
+def test_fp8_tuning_group_key_uses_cublaslt_configuration():
+    _skip_unless_backend("cublas")
+    _, runner, inputs = _runner_and_inputs("cublas", 1)
+    assert runner.get_tuning_group_key(-1, inputs) == -1
+    tactics = runner.get_valid_tactics(inputs, None)
+    assert tactics
+    key = runner.get_tuning_group_key(tactics[0], inputs)
+    assert key[0] == "cublaslt_config"
+    if key[3] != 130101 or _compute_capability() != 121:
+        pytest.skip(
+            "recorded opaque descriptors are specific to cuBLASLt 13.1.1 on GB10"
+        )
+
+    # Two ranks enumerated matching configurations with distinct serialized bytes.
+    left = (
+        77309411395,
+        4294967332,
+        0,
+        7,
+        558783366299649,
+        120259084316,
+        292058693646,
+        0,
+    )
+    right = (*left[:4], 558783604064257, *left[5:])
+    different = (1387274436675, 4294967332, 0, 29, *left[4:])
+    assert runner.get_tuning_group_key(left, inputs) == runner.get_tuning_group_key(
+        right, inputs
+    )
+    assert runner.get_tuning_group_key(left, inputs) != runner.get_tuning_group_key(
+        different, inputs
+    )
+
+
 @pytest.mark.parametrize("backend", ["cublas", "cublaslt"])
 def test_invalid_descriptor_runs_heuristic_default(
     backend, descriptor_runs, monkeypatch
