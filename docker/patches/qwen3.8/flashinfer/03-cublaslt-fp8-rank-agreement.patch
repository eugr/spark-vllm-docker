@@ -31,6 +37,41 @@ void CutlassSegmentGEMM(TensorView workspace_buffer, TensorView all_problems, Te
                         TensorView w_ptr, TensorView y_ptr, TensorView x_ld, TensorView w_ld,
                         TensorView y_ld, TensorView empty_x_data, bool weight_column_major);
 
+// cuBLASLt descriptors are opaque. Two ranks can get different serialized bytes
+// for the same algorithm configuration. Keep the descriptor intact for replay.
+static ffi::Array<int64_t> cublaslt_algo_config_key(TensorView desc) {
+  CHECK_CPU(desc);
+  CHECK_CONTIGUOUS(desc);
+  CHECK_INPUT_TYPE(desc, dl_uint8);
+  cublasLtMatmulAlgo_t algo;
+  TVM_FFI_ICHECK_EQ(desc.numel(), sizeof(algo));
+  std::memcpy(&algo, desc.data_ptr(), sizeof(algo));
+
+  ffi::Array<int64_t> key{static_cast<int64_t>(cublasLtGetVersion())};
+  auto append = [&](auto value, std::initializer_list<cublasLtMatmulAlgoConfigAttributes_t> attrs) {
+    for (auto attr : attrs) {
+      size_t written = 0;
+      if (cublasLtMatmulAlgoConfigGetAttribute(&algo, attr, &value, sizeof(value), &written) !=
+              CUBLAS_STATUS_SUCCESS ||
+          written != sizeof(value)) {
+        return false;
+      }
+      key.push_back(value);
+    }
+    return true;
+  };
+  if (!append(uint32_t{}, {CUBLASLT_ALGO_CONFIG_ID, CUBLASLT_ALGO_CONFIG_TILE_ID,
+                           CUBLASLT_ALGO_CONFIG_SPLITK_NUM, CUBLASLT_ALGO_CONFIG_REDUCTION_SCHEME,
+                           CUBLASLT_ALGO_CONFIG_CTA_SWIZZLING, CUBLASLT_ALGO_CONFIG_CUSTOM_OPTION,
+                           CUBLASLT_ALGO_CONFIG_STAGES_ID}) ||
+      !append(uint16_t{},
+              {CUBLASLT_ALGO_CONFIG_INNER_SHAPE_ID, CUBLASLT_ALGO_CONFIG_CLUSTER_SHAPE_ID})) {
+    return {};
+  }
+  return key;
+}
+
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(cublaslt_algo_config_key, cublaslt_algo_config_key);
 TVM_FFI_DLL_EXPORT_TYPED_FUNC(cutlass_segment_gemm, CutlassSegmentGEMM);
