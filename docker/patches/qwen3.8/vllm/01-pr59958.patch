+        Qwen4ExpPLENvFp4EmbeddingMethod.decode_rows(
+            weight,
+            scale[0],
+            self.weight_scale_2,
+            self._row_ids[:num_rows],
+            output,
+            0,
+            num_rows,
+        )
+        return output.flatten(-2)
