+            shape, dtype = (*rows, plane.shape[1]), plane.dtype
+            host = torch.empty(shape, dtype=dtype, device="cpu", pin_memory=pin)
+            self._planes[name] = (
+                torch.zeros(shape, dtype=dtype, device=device),
+                host,
+                torch.empty_like(host).view(torch.uint8).flatten(0, 1),
+            )
+        if self._nvfp4:
