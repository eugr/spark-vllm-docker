+def make_loader(loaders, root, files, *, unused=None, prefix=""):
+    loader = loaders.adapter(LoadConfig())
+    loader._session = QueuedWriter()
+    loader._prepare_weights = lambda *args: (
+        str(root),
+        [str(root / name) for name in files],
+        True,
+        "model.safetensors.index.json",
+    )
+    source = loaders.default.Source(
+        str(root), None, prefix=prefix, is_unused_weight=unused
+    )
+    return loader, source
