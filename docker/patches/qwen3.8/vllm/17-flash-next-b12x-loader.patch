+    )
+    loader, source = make_loader(loaders, tmp_path, ["mixed.safetensors"])
+    weights = dict(loader._get_weights_iterator(source))
+    assert list(weights) == names
+    assert loader._session.reads == ["a.weight", "z.weight"]
+    ple = weights[names[1]]
+    assert ple.device.type == "cpu"
+    torch.testing.assert_close(ple, torch.arange(16).reshape(4, 4) + 1)
+    maps = definitions(
+        "vllm/models/qwen4_exp/nvidia/ngram_embedding.py", {"_maps_entry"}
+    )
+    path, offset = maps._maps_entry(ple.data_ptr())
+    assert Path(path) == tmp_path / "mixed.safetensors"
+    with open(path, "rb") as stream:
+        stream.seek(offset)
+        actual = torch.frombuffer(bytearray(stream.read(ple.nbytes)), dtype=ple.dtype)
+    torch.testing.assert_close(actual, ple.flatten())
