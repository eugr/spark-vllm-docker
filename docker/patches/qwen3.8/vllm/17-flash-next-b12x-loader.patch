+def definitions(path, names, namespace=None, *, owner=None):
+    """Execute actual source definitions with small dependency substitutes."""
+    tree = ast.parse((ROOT / path).read_text())
+    if owner is not None:
+        tree = next(node for node in tree.body if getattr(node, "name", None) == owner)
+    nodes = [node for node in tree.body if getattr(node, "name", None) in names]
+    assert {node.name for node in nodes} == set(names)
+    for node in ast.walk(ast.Module(body=nodes, type_ignores=[])):
+        if isinstance(node, (ast.ClassDef, ast.FunctionDef)):
+            node.decorator_list = [
+                decorator
+                for decorator in node.decorator_list
+                if not (
+                    isinstance(decorator, ast.Call)
+                    and isinstance(decorator.func, ast.Name)
+                    and decorator.func.id == "instrument"
+                )
+            ]
+    ns = dict(globals(), **(namespace or {}))
+    future = ast.parse("from __future__ import annotations").body
+    exec(compile(ast.Module(body=future + nodes, type_ignores=[]), path, "exec"), ns)
+    return SimpleNamespace(**ns)
