+def test_reader_and_transfer_scope_close_on_load_failure(
+    loaders, transfer, monkeypatch
+):
+    session = QueuedWriter()
+    closed = []
+
+    class SessionContext:
+        def __init__(self, *args, **kwargs):
+            assert kwargs == {"io_threads": 8, "read_mode": "bounce"}
+
+        def __enter__(self):
+            return session
+
+        def __exit__(self, *args):
+            closed.append(True)
+
+    module = ModuleType("b12x.loader")
+    module.DirectWeightSession = SessionContext
+    module.capabilities = lambda index: {"host_page_tables": True}
+    monkeypatch.setitem(sys.modules, "b12x.loader", module)
+
+    def fail(*args):
+        assert transfer.is_weight_transfer_active()
+        raise RuntimeError("model load failed")
+
+    monkeypatch.setattr(loaders.base, "load_model", fail, raising=False)
+    loader = loaders.adapter(LoadConfig())
+    with pytest.raises(RuntimeError, match="model load failed"):
+        loader.load_model(*supported_config())
+    assert loader._session is None
+    assert closed == [True]
