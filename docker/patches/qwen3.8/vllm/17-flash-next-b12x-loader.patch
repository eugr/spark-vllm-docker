+class QueuedWriter:
+    """Resolve metadata views to real CPU bytes, deferring destination writes."""
+
+    def __init__(self):
+        self.sources = {}
+        self.pending = []
+        self.reads = []
+
+    def source(self, data):
+        meta = torch.empty(data.shape, dtype=data.dtype, device="meta")
+        # Retain the storage as well as its identity, just as the native reader does.
+        storage = meta.untyped_storage()
+        self.sources[storage._cdata] = (storage, data)
+        return meta
+
+    def materialize(self, source):
+        self.flush()
+        if not source.is_meta:
+            return source.clone()
+        _, data = self.sources[source.untyped_storage()._cdata]
+        return data.as_strided(
+            source.shape, source.stride(), source.storage_offset()
+        ).clone()
+
+    def __call__(self, destination, source):
+        if not source.is_meta:
+            self.flush()
+            return False
+        _, data = self.sources[source.untyped_storage()._cdata]
+        values = data.as_strided(source.shape, source.stride(), source.storage_offset())
+        self.pending.append((destination, values.clone()))
+        return True
+
+    def flush(self):
+        for destination, data in self.pending:
+            destination.copy_(data)
+        self.pending.clear()
+
+    def finish(self):
+        self.flush()
+
+    def weights(self, files, *, index_path, needs_values, skip):
+        with safe_open(files[0], framework="pt", device="cpu") as handle:
+            for name in sorted(handle.keys()):
+                if skip(name):
+                    continue
+                self.reads.append(name)
+                data = handle.get_tensor(name)
+                entry = SimpleNamespace(name=name, shape=data.shape)
+                yield name, data if needs_values(entry) else self.source(data)
+
