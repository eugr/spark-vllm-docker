+@pytest.mark.parametrize("resident", [False, True])
+def test_csf_modes_preserve_values(tmp_path, loaders, transfer, resident):
+    # Sixteen rows, two columns: base 1, packed codes 2 and 3 => bytes 3 and 4.
+    fixed = torch.cat(
+        (
+            torch.ones(1, 16, dtype=torch.uint8),
+            torch.full((1, 16), 0x32, dtype=torch.uint8),
+        ),
+        dim=1,
+    )
+    exceptions = torch.empty(0, dtype=torch.uint32)
+    prefix = "expert.weight_scale"
+    save_file(
+        {
+            prefix + ".nvfp4_csf_fixed": fixed,
+            prefix + ".nvfp4_csf_exceptions": exceptions,
+        },
+        tmp_path / "csf.safetensors",
+    )
+    loader, source = make_loader(loaders, tmp_path, ["csf.safetensors"])
+    loaders.envs.VLLM_CSF_RESIDENT = resident
+    with transfer.weight_transfer(loader._session):
+        weights = dict(loader._get_weights_iterator(source))
+    if resident:
+        assert all(tensor.is_meta for tensor in weights.values())
+        torch.testing.assert_close(
+            loader._session.materialize(weights[prefix + ".nvfp4_csf_fixed"]), fixed
+        )
+    else:
+        expected = torch.tensor([[3, 4]] * 16, dtype=torch.uint8)
+        torch.testing.assert_close(weights[prefix].view(torch.uint8), expected)
