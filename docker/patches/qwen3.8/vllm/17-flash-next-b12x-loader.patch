+def test_draft_skips_target_files_and_stale_index_entries(tmp_path, loaders):
+    save_file(
+        {"mtp.weight": torch.arange(8), "target.weight": torch.arange(4)},
+        tmp_path / "draft.safetensors",
+    )
+    (tmp_path / "target.safetensors").write_bytes(b"must never be opened")
+    (tmp_path / "model.safetensors.index.json").write_text(
+        json.dumps(
+            {
+                "weight_map": {
+                    "mtp.weight": "draft.safetensors",
+                    "target.weight": "target.safetensors",
+                }
+            }
+        )
+    )
+    loader, source = make_loader(
+        loaders,
+        tmp_path,
+        ["target.safetensors", "draft.safetensors"],
+        unused=lambda name: not name.startswith("mtp."),
+        prefix="draft.",
+    )
+    weights = dict(loader._get_weights_iterator(source))
+    assert list(weights) == ["draft.mtp.weight"]
+    torch.testing.assert_close(
+        loader._session.materialize(weights["draft.mtp.weight"]), torch.arange(8)
+    )
+    assert loader._session.reads == ["mtp.weight"]
