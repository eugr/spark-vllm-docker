diff --git a/vllm/model_executor/model_loader/b12x_loader.py b/vllm/model_executor/model_loader/b12x_loader.py
new file mode 100644
index 0000000000000000000000000000000000000000..6d256786f34b3f0384a5cf98ed56409ea5de9762
--- /dev/null
+++ b/vllm/model_executor/model_loader/b12x_loader.py
@@ -0,0 +1,212 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Flash Next checkpoint loading on Spark through FlashInfer's B12X reader.
+
+Adapted from local-inference-lab/vllm at
+3a947437cf1eb734299de91370c9b37fcdbcc42b. PLE tables retain upstream's mmap
+transport for device, pinned-host and host-file-gather storage. Other weights
+are routed as metadata into their final CUDA parameter slices.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import heapq
+import json
+import math
+import time
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+from vllm.model_executor.model_loader.csf_scales import decode_csf_scale_streams
+from vllm.model_executor.model_loader.default_loader import DefaultModelLoader
+from vllm.model_executor.weight_transfer import weight_transfer
+
+logger = init_logger(__name__)
+
+
+def _is_ple_weight(name: str) -> bool:
+    return ".ngram_embedding." in f".{name}"
+
+
+class B12xModelLoader(DefaultModelLoader):
+    """Opt-in Flash Next loader for Spark, including its embedded MTP draft."""
+
+    def __init__(self, load_config):
+        options = load_config.model_loader_extra_config
+        if not isinstance(options, dict):
+            raise ValueError("b12x model_loader_extra_config must be a dict")
+        options = dict(options)
+        self.io_threads = options.pop("io_threads", 8)
+        if type(self.io_threads) is not int or not 1 <= self.io_threads <= 16:
+            raise ValueError("b12x io_threads must be an integer between 1 and 16")
+        if options.pop("read_mode", "auto") not in ("auto", "bounce"):
+            raise ValueError("the regular b12x loader supports Spark auto/bounce reads")
+        if options.get("enable_multithread_load"):
+            raise ValueError("b12x requires synchronous checkpoint routing")
+        if load_config.safetensors_load_strategy not in (None, "lazy"):
+            raise ValueError("b12x does not use safetensors read strategies")
+        super().__init__(
+            dataclasses.replace(
+                load_config,
+                load_format="safetensors",
+                model_loader_extra_config=options,
+            )
+        )
+        self._session = None
+
+    def load_model(self, vllm_config, model_config, prefix=""):
+        parallel = vllm_config.parallel_config
+        if (
+            parallel.tensor_parallel_size not in (1, 2)
+            or parallel.pipeline_parallel_size != 1
+            or parallel.data_parallel_size != 1
+            or parallel.prefill_context_parallel_size != 1
+            or parallel.decode_context_parallel_size != 1
+            or parallel.enable_expert_parallel
+            or parallel.enable_eplb
+        ):
+            raise ValueError("the regular b12x loader supports Flash Next TP=1/2 only")
+        if model_config.enable_cumem_allocator:
+            raise ValueError("the regular b12x loader does not support sleep mode")
+        if (
+            model_config.multimodal_config is not None
+            and model_config.multimodal_config.mm_encoder_only
+        ):
+            raise ValueError(
+                "the regular b12x loader requires the full Flash Next model"
+            )
+        device = torch.device(
+            self.load_config.device or vllm_config.device_config.device
+        )
+        if device.type != "cuda":
+            raise ValueError("the b12x loader requires a CUDA device")
+        index = torch.cuda.current_device() if device.index is None else device.index
+
+        # Keep FlashInfer optional for every other load format, including CPU use.
+        from b12x.loader import DirectWeightSession, capabilities
+
+        if not capabilities(index)["host_page_tables"]:
+            raise ValueError("the regular b12x loader requires Spark host page tables")
+        with (
+            DirectWeightSession(
+                index, io_threads=self.io_threads, read_mode="bounce"
+            ) as session,
+            weight_transfer(session),
+        ):
+            self._session = session
+            try:
+                model = super().load_model(vllm_config, model_config, prefix)
+                stats = session.stats()
+            finally:
+                self._session = None
+        model._b12x_loader_storage = {
+            "parameter_bytes": sum(p.nbytes for p in model.parameters()),
+            "io": stats,
+        }
+        logger.debug("b12x checkpoint I/O counters (excluding mmap PLE): %s", stats)
+        return model
+
+    def load_weights(self, model, model_config):
+        if self._session is None:
+            raise ValueError(
+                "b12x requires an initial-load session; reload is unsupported"
+            )
+        if type(model).__name__ not in {
+            "Qwen4ExpForCausalLM",
+            "Qwen4ExpForConditionalGeneration",
+            "Qwen4ExpMTP",
+        }:
+            raise ValueError(
+                "the regular b12x loader currently supports Flash Next only"
+            )
+        super().load_weights(model, model_config)
+
+    @staticmethod
+    def _needs_values(entry):
+        return math.prod(entry.shape) == 1 or entry.name.rsplit(".", 1)[-1] in {
+            "layer_multipliers",
+            "ngram_heads_offsets",
+            "ngram_heads_vocab_sizes",
+        }
+
+    def _get_weights_iterator(self, source):
+        session = self._session
+        if session is None:
+            raise RuntimeError("b12x requires an active initial-load session")
+        folder, files, use_safetensors, index_file = self._prepare_weights(
+            source.model_or_path,
+            source.subfolder,
+            source.revision,
+            False,
+            source.allow_patterns_overrides,
+        )
+        if not use_safetensors:
+            raise ValueError("b12x requires safetensors checkpoints")
+        index_path = Path(folder) / index_file
+        weight_map = None
+        if index_path.is_file():
+            weight_map = json.loads(index_path.read_text())["weight_map"]
+        unused = source.is_unused_weight or (lambda name: False)
+        if weight_map is not None:
+            # In particular, an MTP load must not open unrelated target shards.
+            wanted_files = {
+                (index_path.parent / filename).resolve()
+                for name, filename in weight_map.items()
+                if not unused(name)
+            }
+            files = [path for path in files if Path(path).resolve() in wanted_files]
+        if not files:
+            raise ValueError("No checkpoint shards selected for the b12x load")
+
+        def checkpoint_weights():
+            for path in files:
+                resolved_path = Path(path).resolve()
+
+                def selected(name, resolved_path=resolved_path):
+                    if unused(name):
+                        return False
+                    if weight_map is None:
+                        return True
+                    filename = weight_map.get(name)
+                    return (
+                        filename is not None
+                        and (index_path.parent / filename).resolve() == resolved_path
+                    )
+
+                # Only PLE tensors are mmap views. This preserves the regular
+                # file-gather binding and pinned-host loader without staging
+                # the full tables through CUDA allocations.
+                with safe_open(path, framework="pt", device="cpu") as handle:
+                    file_names = handle.keys()
+                    names = sorted(name for name in file_names if selected(name))
+                    ple_names = [name for name in names if _is_ple_weight(name)]
+                    ple_weights = (
+                        (name, handle.get_tensor(name)) for name in ple_names
+                    )
+                    ordinary = (
+                        session.weights(
+                            [path],
+                            index_path=index_path,
+                            needs_values=self._needs_values,
+                            skip=lambda name: (
+                                not selected(name) or _is_ple_weight(name)
+                            ),
+                        )
+                        if len(names) > len(ple_names)
+                        else ()
+                    )
+                    yield from heapq.merge(
+                        ordinary, ple_weights, key=lambda item: item[0]
+                    )
+
