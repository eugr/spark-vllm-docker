+def test_moe_padded_slices_keep_padding_and_both_gate_shards(transfer, rank):
+    methods = definitions(
+        "vllm/model_executor/layers/fused_moe/routed_experts.py",
+        {"_get_hidden_dim", "_narrow_expert_data_for_padding", "_load_w13", "_load_w2"},
+        dict(copy_weight=transfer.copy_weight),
+        owner="RoutedExperts",
+    )
+    expert = SimpleNamespace(
+        moe_config=SimpleNamespace(
+            is_act_and_mul=True, moe_parallel_config=SimpleNamespace(tp_size=2)
+        ),
+        _get_hidden_dim=methods._get_hidden_dim,
+        _narrow_expert_data_for_padding=methods._narrow_expert_data_for_padding,
+    )
+    gate = torch.arange(32, dtype=torch.float32).reshape(8, 4)
+    down = torch.arange(32, dtype=torch.float32).reshape(4, 8)
+    w13, w2 = torch.full((12, 6), -1.0), torch.full((6, 6), -1.0)
+    writer = QueuedWriter()
+    with transfer.weight_transfer(writer):
+        for shard, values in (("w1", gate), ("w3", gate + 100)):
+            methods._load_w13(expert, w13, 0, shard, writer.source(values), rank)
+        methods._load_w2(expert, w2, 1, writer.source(down), rank)
+        transfer.finish_weight_transfers()
+    expected = torch.full_like(w13, -1)
+    expected[:4, :4] = gate[rank * 4 : (rank + 1) * 4]
+    expected[6:10, :4] = gate[rank * 4 : (rank + 1) * 4] + 100
+    torch.testing.assert_close(w13, expected)
+    expected2 = torch.full_like(w2, -1)
+    expected2[:4, :4] = down[:, rank * 4 : (rank + 1) * 4]
+    torch.testing.assert_close(w2, expected2)
