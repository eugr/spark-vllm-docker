+def _wait_for_metric_delta(
+    metric_name: str,
+    port: str,
+    baseline: float,
+    expected: float,
+    timeout: float = 10,
+) -> float:
+    deadline = time.monotonic() + timeout
+    while True:
+        delta = _fetch_metric(metric_name, port) - baseline
+        if delta >= expected or time.monotonic() >= deadline:
+            return delta
+        time.sleep(0.1)
