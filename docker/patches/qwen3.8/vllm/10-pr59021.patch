From: schopde-nvidia
Subject: [PATCH] [Kernel] Allow steering the unquantized linear backend independently

Upstream-PR: https://github.com/vllm-project/vllm/pull/59021
Upstream-Commit: 0d1a683a3471ce352ef5a9aa2d7a9616bd1ac4bf
Integration-Base: 8084f0624dba24aba6ebac62d8e10cc00730a0fe

Preserve upstream RDNA hybrid prefill dequantization settings and validation.

diff --git a/vllm/config/kernel.py b/vllm/config/kernel.py
index 18ad1321ea956eadffb80648002f40763619cfd1..b6908e95c5537b1bd7c773acb8300c62ffe96114 100644
--- a/vllm/config/kernel.py
+++ b/vllm/config/kernel.py
@@ -427,6 +427,11 @@ class KernelConfig:
     precedence over ``linear_backend``; for example,
     ``{"nvfp4_w4a16": "humming"}``."""
 
+    unquantized_linear_backend: LinearBackend = "auto"
+    """Backend override for unquantized linear layers only, decoupled from
+    ``linear_backend`` (which also drives the quantized kernel selector).
+    "auto" (default) falls back to ``linear_backend``."""
+
     rdna_hybrid_w4a16_prefill_dequant: RDNAHybridW4A16PrefillDequantMode = "disable"
     """Cache a dense dequantized copy of each weight for the RDNA hybrid W4A16
     linear kernel's prefill GEMM. Applies only on gfx11/gfx12 RDNA GPUs, where
@@ -450,7 +455,7 @@ class KernelConfig:
             return value.lower().replace("-", "_")
         return value
 
-    @field_validator("linear_backend", mode="before")
+    @field_validator("linear_backend", "unquantized_linear_backend", mode="before")
     @classmethod
     def _normalize_linear_backend(cls, value: Any) -> Any:
         if isinstance(value, str):
